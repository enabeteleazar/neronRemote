# Exemple d'unite systemd pour lancer l'agent au demarrage.
#
# A copier vers /etc/systemd/system/pc-remote-agent.service sur la machine
# Ubuntu a piloter, puis adapter WorkingDirectory/ExecStart/User et definir
# PC_AGENT_TOKEN via un EnvironmentFile prive (jamais en clair ici).
#
# systemctl daemon-reload
# systemctl enable --now pc-remote-agent

[Unit]
Description=Neron PC Remote Agent
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=neron-remote
WorkingDirectory=/opt/pc_remote_linux
EnvironmentFile=/opt/pc_remote_linux/pc-remote-agent.env
# tailscaled.service "demarre" bien avant d'avoir fini de s'authentifier et
# de s'assigner une IP : sans cette attente, l'agent tente de bind sur l'IP
# Tailscale de config.yaml avant qu'elle existe (cannot assign requested
# address), provoquant une tempete de redemarrages (RestartSec) jusqu'a ce
# que Tailscale se stabilise de son cote.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do /usr/bin/tailscale ip -4 >/dev/null 2>&1 && exit 0; sleep 1; done; echo "tailscale ip -4 indisponible apres 30s" >&2; exit 1'
ExecStart=/opt/pc_remote_linux/venv/bin/python main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Si des applications graphiques doivent etre pilotees, ce service doit
# tourner dans une session avec DISPLAY/XAUTHORITY valides (rare sur un
# serveur headless) : ajoutez Environment=DISPLAY=:0 et l'acces au socket X
# le cas echeant. Pour du pilotage CLI/scripts, rien de plus n'est requis.

[Install]
WantedBy=multi-user.target
